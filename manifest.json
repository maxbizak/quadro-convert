{
  "manifest": 2,
  "id": "quadro.convert",
  "name": "Конвертер",
  "summary": "Видео, аудио и картинки в любой формат — на вашем ПК",
  "description": "Конвертирует, сжимает, обрезает видео, делает GIF и вынимает звук. Всё делается на вашем компьютере движком FFmpeg — файлы не уходят в интернет. У видео в чатах Hub — «Убрать звук», «Сжать…» и «Вытащить звук в mp3», у звука — «Перевести в mp3»; видео и звук открываются в Конвертере через «Открыть с помощью»; в личных сообщениях — команда /сжать. Права: выбрать файлы (окно Windows), показать результат в папке и открыть его, свою папку данных (история заданий) и запуск FFmpeg, который ставится вместе с приложением.",
  "version": "1.2.3",
  "icon": "file-text",
  "engines": {
    "hub": "^2.0"
  },
  "license": "proprietary",
  "madeByAi": "mostly",
  "parts": {
    "client": "client",
    "pc": {
      "entry": "pc/part.cjs",
      "platforms": [
        "win32-x64"
      ],
      "activation": [
        "onScreen"
      ],
      "downloads": [
        {
          "id": "ffmpeg",
          "url": "https://www.gyan.dev/ffmpeg/builds/packages/ffmpeg-9.0.2-essentials_build.zip",
          "sha256": "60f467265b1e312373dbcd92200c2618a74850f98d3d078e94296bb3fa2047ba",
          "size": 114768076,
          "unpack": "zip"
        }
      ]
    }
  },
  "permissions": [
    "pc.files.own",
    "pc.files.pick",
    "pc.files.reveal",
    "pc.files.open",
    "pc.process"
  ],
  "views": {
    "main": {
      "surface": "web",
      "title": "Конвертер",
      "entry": "index.html"
    },
    "compress": {
      "surface": "web",
      "title": "Сжать",
      "entry": "index.html"
    },
    "video": {
      "surface": "web",
      "title": "Видео",
      "entry": "index.html"
    },
    "done": {
      "surface": "web",
      "title": "Готовое",
      "entry": "index.html"
    }
  },
  "contributes": {
    "shell.railApp@1": [
      {
        "id": "main",
        "title": "Конвертер",
        "icon": "file-text",
        "open": {
          "view": "main"
        },
        "menu": [
          "compress",
          "video",
          "done"
        ]
      }
    ],
    "shell.command@1": [
      {
        "id": "convert",
        "title": "Конвертировать файл",
        "icon": "file-text",
        "category": "Конвертер",
        "keywords": [
          "конвертер",
          "mp4",
          "mp3",
          "webm",
          "png",
          "jpg",
          "webp",
          "формат",
          "convert"
        ],
        "run": {
          "kind": "open",
          "view": "main"
        }
      },
      {
        "id": "compress",
        "title": "Сжать видео или картинку",
        "icon": "file-text",
        "category": "Конвертер",
        "keywords": [
          "сжать",
          "уменьшить",
          "размер",
          "discord",
          "telegram",
          "compress"
        ],
        "run": {
          "kind": "open",
          "view": "compress"
        }
      },
      {
        "id": "video",
        "title": "Обрезать видео, в GIF, без звука",
        "icon": "file-text",
        "category": "Конвертер",
        "keywords": [
          "обрезать",
          "gif",
          "гиф",
          "звук",
          "повернуть",
          "trim"
        ],
        "run": {
          "kind": "open",
          "view": "video"
        }
      },
      {
        "id": "done",
        "title": "Готовые файлы Конвертера",
        "icon": "file-text",
        "category": "Конвертер",
        "keywords": [
          "готовое",
          "результат",
          "конвертер"
        ],
        "run": {
          "kind": "open",
          "view": "done"
        }
      }
    ],
    "shell.openWith@1": [
      {
        "id": "media",
        "title": "Конвертер",
        "icon": "file-text",
        "extensions": [
          "mp4",
          "mkv",
          "webm",
          "mov",
          "avi",
          "m4v",
          "flv",
          "wmv",
          "mp3",
          "wav",
          "ogg",
          "opus",
          "m4a",
          "aac",
          "flac",
          "wma"
        ],
        "view": "main",
        "multiple": true
      }
    ],
    "shell.objectAction@1": [
      {
        "id": "mute",
        "title": "Убрать звук",
        "icon": "volume-x",
        "description": "Копия видео без звука — рядом с файлом, без пережатия",
        "object": "file",
        "match": {
          "mime": "video/*"
        },
        "order": 100,
        "run": {
          "kind": "pc",
          "method": "actMute"
        }
      },
      {
        "id": "compress",
        "title": "Сжать…",
        "icon": "minimize-2",
        "description": "Пережать видео до нужного размера (Discord, Telegram)",
        "object": "file",
        "match": {
          "mime": "video/*"
        },
        "order": 110,
        "run": {
          "kind": "pc",
          "method": "actCompress",
          "form": {
            "title": "Сжать видео",
            "description": "Видео пережмётся так, чтобы уложиться в размер. Discord без Nitro — 10 МБ, Telegram — до 2000 МБ.",
            "submit": "Сжать",
            "fields": [
              {
                "key": "targetMB",
                "type": "number",
                "label": "Размер файла",
                "default": 10,
                "min": 1,
                "max": 4000,
                "unit": "МБ",
                "required": true
              }
            ]
          }
        }
      },
      {
        "id": "audio",
        "title": "Вытащить звук в mp3",
        "icon": "music",
        "description": "Звук видео отдельным файлом mp3",
        "object": "file",
        "match": {
          "mime": "video/*"
        },
        "order": 120,
        "run": {
          "kind": "pc",
          "method": "actAudio"
        }
      },
      {
        "id": "to-mp3",
        "title": "Перевести в mp3",
        "icon": "music",
        "description": "Копия звука в mp3 — рядом с файлом",
        "object": "file",
        "match": {
          "mime": "audio/*"
        },
        "order": 120,
        "run": {
          "kind": "pc",
          "method": "actToMp3"
        }
      }
    ],
    "servers.command@1": [
      {
        "id": "compress",
        "name": "сжать",
        "title": "Сжать видео",
        "description": "Выберите видео на ПК — Конвертер пережмёт его до нужного размера, чтобы отправить в беседу",
        "icon": "minimize-2",
        "scopes": [
          "dm",
          "self"
        ],
        "options": [
          {
            "key": "targetMB",
            "type": "number",
            "label": "Размер, МБ",
            "default": 10,
            "min": 1,
            "max": 4000,
            "unit": "МБ",
            "required": true
          }
        ],
        "run": {
          "handler": "pc:chatCompress"
        }
      }
    ]
  }
}
