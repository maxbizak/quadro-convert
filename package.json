{
  "name": "quadro-convert",
  "private": true,
  "version": "1.2.1",
  "description": "«Конвертер» — пакет Quadro Hub (quadro.convert): экран в песочнице + часть на ПК с FFmpeg",
  "type": "module",
  "scripts": {
    "build": "vite build && node scripts/build-pc.mjs",
    "build:client": "vite build",
    "build:pc": "node scripts/build-pc.mjs",
    "watch": "vite build --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.pc.json",
    "test": "vitest run",
    "pack": "node scripts/pack.mjs"
  },
  "dependencies": {
    "lucide-react": "1.56.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@quadrohub/pc-sdk": "file:../../QuadroHub/packages/pc-sdk",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
